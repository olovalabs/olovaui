```gitignore
# Dependencies
node_modules/

# Build outputs
.next/
dist/
build/
out/

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log

# Python cache (if applicable)
__pycache__/
*.pyc
*.pyo
*.pyd

# Coverage reports
coverage/
htmlcov/
.coverage

# Temporary files
*.tmp
*.temp
.DS_Store
Thumbs.db

# Package manager caches
.npm/
.yarn/
.pnpm-store/
```